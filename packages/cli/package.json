{
  "name": "toolkit-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI oficial do Toolkit — busca, instala e gerencia apps direto do terminal",
  "license": "MIT",
  "bin": {
    "toolkit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguellima2326/ToolKit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://tool-kit-web-liart.vercel.app/",
  "bugs": "https://github.com/miguellima2326/ToolKit/issues",
  "keywords": [
    "cli",
    "winget",
    "homebrew",
    "apt",
    "installer",
    "package-manager"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.shared.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^0.9.1",
    "@toolkit/shared": "workspace:*",
    "@toolkit/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "commander": "^13.1.0",
    "eslint": "^9.17.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
