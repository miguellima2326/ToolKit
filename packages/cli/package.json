{
  "name": "@toolkit/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI oficial do Toolkit — busca, instala e gerencia apps direto do terminal",
  "type": "module",
  "bin": {
    "toolkit": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.shared.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@toolkit/shared": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@toolkit/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
